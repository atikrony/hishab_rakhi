# ==========================================
# Behishebi - Environment Configuration Template
# ==========================================

PORT=3000
NODE_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
MOBILE_API_KEY=your_mobile_api_key_here

NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL=৳
NEXT_PUBLIC_APP_NAME="Behishebi"

# ==============================================================================
# PostgreSQL Database Configuration (For DBeaver & Production)
# ==============================================================================
# Connect to your local PostgreSQL (default port 5432) or any cloud PostgreSQL:
# e.g. Neon, Supabase, Railway, Render, Docker, AWS RDS, etc.
USE_POSTGRES=true
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/hishab_rakhi
PGHOST=localhost
PGPORT=5432
PGDATABASE=hishab_rakhi
PGUSER=your_db_user
PGPASSWORD=your_db_password

# Local File Database Configuration (Fallback)
DATABASE_MODE=real
DATABASE_NAME=hishab_real.json
DATA_STORAGE_DIR=./data

# ==============================================================================
# Google OAuth 2.0 Sign-In Credentials
# ==============================================================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ==============================================================================
# Email (verification + password reset) via Resend - https://resend.com
# ==============================================================================
# Without RESEND_API_KEY in development, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Behishebi <no-reply@yourdomain.com>"

